@startuml basket
top to bottom direction

package Model {
    class Equipo {
        -nombre: String
        -contadorBases: int
        -contadorEscolta: int
        -contadorAlero: int
        -contadorAlaPivot: int
        -contadorPivot: int
        -jugadores: List<Jugador>
        +agregarJugador(jugador: Jugador): boolean
        +eliminarJugador(dorsal: int): boolean
        +actualizarArchivoJugadores(): void
        +contarJugadoresPosicion(): void
    }

    abstract class Jugador {
        -nombre: String
        -tipo: String
        -dorsal: int
        -altura: int
        -habilidad: int
        -puntos: int
        -faltas: int
        +anotarPuntos(puntos: int): void
        +hacerFalta(): void
    }

    class Base
    class Escolta
    class Alero
    class AlaPivot
    class Pivot

    abstract class Partido {
        #MAX_PUNTOS: int = 150
        #MIN_PUNTOS: int = 35
        #arbitro: Arbitro
        #resultadoLocal: int
        #resultadoVisitante: int
        #ganador: Equipo
        #equipoLocal: Equipo
        #equipoVisitante: Equipo
        +calcularResultado(): Equipo
        +generarPuntuacion(random: Random): int
    }

    class PartidoExhibicion
    class PartidoOficial {
        +verificarPartido(rival: Equipo): boolean
    }

    class Arbitro {
        -nombre: String
        -enfermo: boolean
        -arbitros: List<Arbitro>
        +estarEnfermo(): boolean
        +elegirArbitro(): Arbitro
    }

    interface GestorArchivo {
        +leerEquipos(): List<Equipo>
        +leerArbitros(): List<Arbitro>
        +leerJugadores(): List<Jugador>
        +leerUltimoPartido(): String
        +leerHistoricoTemporada(): String
        +guardarResumen(equipo: Equipo, partido: Partido): void
        +guardarResumenUltimoPartido(equipo: Equipo, partido: Partido): void
        +guardarResumenJugador(equipo: Equipo, tipo: String): void
        +guardarHistoricoTemporada(): void
        +guardarJugador(jugadores: List<Jugador>): void
        +eliminarJugador(dorsal: int): void
        +mostrarJugadores(): void
    }

    class Fichero

    class Temporada {
        -instancia: static Temporada
        -partidos: List<Partido>
        -equipos: List<Equipo>
        -equiposJugados: List<Equipo>
        +getInstancia(): Temporada
        +registrarPartidoJugado(partido: Partido): void
        +verificarFinTemporada(equipo: Equipo): boolean
        +jugarPartido(local: Equipo, visitante: Equipo, arbitro: Arbitro, esOficial: boolean): Partido
        +getEquipoPorNombre(nombre: String): Equipo
        +verificarPartidoYaJugado(equipo1: Equipo, equipo2: Equipo): boolean
        +mostrarEquiposDisponibles(local: Equipo): List<Equipo>
        +getUltimoPartido(): Partido
    }
}

package View {
    class Main
}

package Controller {
    class Controller {
        -gestorEntradaSalida: GestorEntradaSalida
        -fichero: Fichero
        -equipo: Equipo
        +menu(): void
    }
}

Temporada *-- Partido
Temporada *-- Equipo
Equipo *-- Jugador
Equipo *-- Partido

Jugador <|-- Base
Jugador <|-- Escolta
Jugador <|-- Alero
Jugador <|-- AlaPivot
Jugador <|-- Pivot

Partido *-- Arbitro
Partido <|-- PartidoOficial
Partido <|-- PartidoExhibicion

GestorArchivo <|.. Fichero

View --> Controller
Controller --> Model
@enduml
